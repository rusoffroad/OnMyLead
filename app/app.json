{
  "expo": {
    "name": "OnMyLead",
    "slug": "onmylead",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onmylead",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rusoffroad.onmylead",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is shared only with riders you choose, only while you are sharing, so your group can stay together.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Keeps sharing with your ride while your phone is locked on the mount. Sharing always stops when your timer ends or the ride ends."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rusoffroad.onmylead"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020A14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Keeps sharing with your ride while your phone is locked on the mount. Sharing always stops when your timer ends or the ride ends."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of your machine for your garage. Only the photo you pick is uploaded.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-starlink-local-network",
      "./plugins/with-scene-lifecycle",
      [
        "./plugins/with-push-entitlement",
        {
          "enabled": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
