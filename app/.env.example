# Copy to .env and fill in from your Supabase project (Settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Where the web build is hosted, used for invite and family links.
EXPO_PUBLIC_WEB_URL=https://ride.example.com

# Crash reporting (Sentry). Leave empty to turn it off; the app works the same without it.
EXPO_PUBLIC_SENTRY_DSN=

# Mapbox public token (starts with pk.). With it every map draws with Mapbox (Standard, Satellite,
# Topo and 3D Terrain). Leave empty and the app falls back to Apple/Google Maps and the Leaflet
# website map, without 3D Terrain.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Ad pixels for onmylead.com (3.0, lib/ad-tracking.web.ts). Each stays off while empty; none loads
# until a visitor taps Allow on the cookie notice. The phone apps send Meta and TikTok events through
# the ad-conversions edge function instead, whose ids and tokens are Supabase secrets.
EXPO_PUBLIC_META_PIXEL_ID=
EXPO_PUBLIC_GOOGLE_ADS_ID=
EXPO_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
EXPO_PUBLIC_GOOGLE_ADS_TRIAL_LABEL=
EXPO_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
EXPO_PUBLIC_TIKTOK_PIXEL_ID=
